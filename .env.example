# provider

## DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

## Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

## 字节方舟 Agent Plan（豆包）。Anthropic 协议，密钥与上面两套分开
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan

# Model
# MODEL_PROVIDER 选哪一套密钥和协议：deepseek | claude | doubao
# MODEL 选模型名，三套客户端共用这一个值
MODEL_PROVIDER=deepseek
MODEL=deepseek-v4-flash
# MODEL_SUPPORTS_IMAGES=false   # 兼容端点确认支持视觉后才设 true

# 部署相关预算。架构比例、提炼切块、循环次数在代码配置里改，见：
# agent/core/config.py、agent/core/perception/config.py、agent/core/memory/config.py
# agent/core/action/config.py（ActionConfig）、agent/types/perception/admission.py（AdmissionConfig）
# Memory 与上下文预算（以下为默认值；显式传入 RuntimeConfig 时覆盖这里）
# AGENT_MODEL_CONTEXT_TOKENS=32768
# AGENT_RESERVED_OUTPUT_TOKENS=4096
# AGENT_MEMORY_MANUAL_TOKENS=1200
# AGENT_MEMORY_EXPERIENCE_TOKENS=600

# 上下文准入（历史工具结果按判官概率 keep / trim / defer）
# CONTEXT_ADMISSION_MODE=shadow   # off | shadow（只记录不生效）| active
# Jev 判官，System One：POST https://jevmodel.org/v1/systemone
# body: {state, model: "jev-latest", questions}；不填 key 时只用规则 + 工具类别先验
JEVMODEL_API_KEY=
# JEV_BASE_URL=https://jevmodel.org/v1/systemone
# JEV_MODEL=jev-latest            # 留空按端点取默认：jevmodel.org=jev-latest，OpenRouter=~typesafe/jev-latest
# JEV_TIMEOUT=6                   # 单批请求超时（秒）
# JEV_BATCH_SIZE=4                # 每批最多 4 条，每条两题，合计不超过端点的 8 题限制
# OpenRouter 同协议：JEV_BASE_URL=https://openrouter.ai/api/v1/systemone

# 经验卡事后评判复用上面的JEV；以下可独立覆盖，主模型不会等待评判。
# MEMORY_JEV_API_KEY=
# MEMORY_JEV_BASE_URL=https://jevmodel.org/v1/systemone
# MEMORY_JEV_MODEL=jev-latest
# 可选：离线相似卡整理。三项全部配置才调用embedding，不改变在线关键词召回。
# MEMORY_EMBEDDING_BASE_URL=https://your-provider.example/v1
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_EMBEDDING_MODEL=

# 前端 HTTP API（python -m agent.main）
# 配置后每个 /api 请求都要带 Authorization: Bearer <token>；frontier 的 vite 代理会自动带上
# AGENT_HTTP_TOKEN=
# 允许的浏览器 Origin（逗号分隔）；其他 Origin 的请求直接 403
# AGENT_HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Channel
# 渠道开关与非敏感配置在 agent/core/channel/registry.json（入库）；
# 密钥只放这里（不入库）。密钥填齐 + registry.json 未显式 "enable": false → 启动自动连接。
# CHANNEL_CONFIG=               # 缺省回退到包内 agent/core/channel/registry.json

## 飞书（lark-oapi websocket 长连）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# domain / bot_open_id 等非敏感配置可写入 registry.json 的 feishu 节

## QQ 官方机器人（wss 网关 + REST）
QQ_APP_ID=
QQ_CLIENT_SECRET=

## 个人微信 iLink Bot（长轮询；token 经 iLink 平台 QR 登录获取）
WEIXIN_TOKEN=
# 可选：协议请求不使用，只用于日志标识
WEIXIN_ACCOUNT_ID=
# 扫码工具会自动写入以下三项；区域接口地址通常无需手填
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com

# 网易邮箱新邮件提醒（agent/core/cron/mail.py，IMAP 直连）
# 授权码在网页邮箱「设置 → POP3/SMTP/IMAP」开启 IMAP 后生成，不是登录密码
NETEASE_MAIL_USER=
NETEASE_MAIL_AUTH_CODE=
# 只有这个用户能用 schedule 工具订阅邮件提醒；值为该用户在所在渠道的 user_id（如飞书 ou_xxx）
NETEASE_MAIL_OWNER=
# NETEASE_IMAP_HOST=imap.163.com
