# provider

## DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

## Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Model
MODEL=deepseek-v4-flash

# Channel
# 渠道开关与非敏感配置在 Agent/channel/registry.json（入库）；
# 密钥只放这里（不入库）。密钥填齐 + registry.json 未显式 "enable": false → 启动自动连接。
# CHANNEL_CONFIG=               # 缺省回退到包内 Agent/channel/registry.json

## 飞书（lark-oapi websocket 长连）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_DOMAIN=feishu            # 海外版填 lark
# FEISHU_BOT_OPEN_ID=             # 缺省时启动自动水合；群聊 @ 识别用

## QQ 官方机器人（wss 网关 + REST）
QQ_APP_ID=
QQ_CLIENT_SECRET=

## 微信（腾讯 iLink Bot API 长轮询；token 经 iLink 平台 QR 登录获取）
WEIXIN_TOKEN=
WEIXIN_ACCOUNT_ID=
