# provider

## DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

## Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Model
MODEL=deepseek-v4-flash
# MODEL_SUPPORTS_IMAGES=false   # 兼容端点确认支持视觉后才设 true

# Memory 与上下文预算（以下为默认值）
# AGENT_MODEL_CONTEXT_TOKENS=32768
# AGENT_RESERVED_OUTPUT_TOKENS=4096
# AGENT_MEMORY_MANUAL_TOKENS=1200
# AGENT_MEMORY_EXPERIENCE_TOKENS=600

# 上下文准入（历史工具结果按判官概率 keep / trim / defer）
# CONTEXT_ADMISSION_MODE=shadow   # off | shadow（只记录不生效）| active
# Jev 判官，System One：POST https://jevmodel.org/v1/systemone
# body: {state, model: "jev-latest", questions}；不填 key 时只用规则 + 工具类别先验
JEVMODEL_API_KEY=
# JEV_BASE_URL=https://jevmodel.org/v1/systemone
# JEV_MODEL=jev-latest            # 留空按端点取默认：jevmodel.org=jev-latest，OpenRouter=~typesafe/jev-latest
# JEV_TIMEOUT=6                   # 单批请求超时（秒）
# JEV_BATCH_SIZE=8                # 每次请求打包的条目数
# OpenRouter 同协议：JEV_BASE_URL=https://openrouter.ai/api/v1/systemone

# 前端 HTTP API（python -m agent.main）
# 配置后每个 /api 请求都要带 Authorization: Bearer <token>；frontier 的 vite 代理会自动带上
# AGENT_HTTP_TOKEN=
# 允许的浏览器 Origin（逗号分隔）；其他 Origin 的请求直接 403
# AGENT_HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Channel
# 渠道开关与非敏感配置在 agent/channel/registry.json（入库）；
# 密钥只放这里（不入库）。密钥填齐 + registry.json 未显式 "enable": false → 启动自动连接。
# CHANNEL_CONFIG=               # 缺省回退到包内 agent/channel/registry.json

## 飞书（lark-oapi websocket 长连）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# domain / bot_open_id 等非敏感配置可写入 registry.json 的 feishu 节

## QQ 官方机器人（wss 网关 + REST）
QQ_APP_ID=
QQ_CLIENT_SECRET=

## 个人微信 iLink Bot（长轮询；token 经 iLink 平台 QR 登录获取）
WEIXIN_TOKEN=
# 可选：协议请求不使用，只用于日志标识
WEIXIN_ACCOUNT_ID=
# 扫码工具会自动写入以下三项；区域接口地址通常无需手填
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
